{
    "name": "@signal24/vue-foundation",
    "type": "module",
    "version": "4.24.0",
    "description": "Common components, directives, and helpers for Vue 3 apps",
    "module": "./dist/vue-foundation.es.js",
    "exports": {
        ".": {
            "import": "./dist/vue-foundation.es.js",
            "types": "./dist/src/index.d.ts"
        },
        "./dist/vue-foundation.css": {
            "import": "./dist/vue-foundation.css",
            "require": "./dist/vue-foundation.css"
        },
        "./vite-plugins": {
            "import": "./dist/src/vite-plugins/index.js",
            "types": "./dist/src/vite-plugins/index.d.ts"
        }
    },
    "typings": "./dist/src/index.d.ts",
    "scripts": {
        "dev": "vite",
        "build": "rm -rf dist && vite build && tsc -p tsconfig.vite-plugins.json && find dist -name '*.tsbuildinfo' -delete && vue-tsc -p tsconfig.app.json",
        "build:watch": "fswatch -o src | xargs -n1 -I{} yarn build",
        "demo": "vite -c ./demo/vite.config.ts ./demo",
        "test:types": "vue-tsc -p tsconfig.vitest.json",
        "test:unit": "vitest",
        "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
        "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
        "test:e2e:dev:remote": "DISPLAY=:0 yarn test:e2e:dev",
        "lint": "eslint --fix .",
        "format": "prettier --write ."
    },
    "license": "MIT",
    "dependencies": {
        "currency.js": "^2.0.4",
        "uuid": "^11.1.0"
    },
    "peerDependencies": {
        "@signal24/openapi-client-codegen": "^2.1.1",
        "date-fns": "^3.0.6",
        "lodash": "^4.17.21",
        "vue": "^3.4.0"
    },
    "devDependencies": {
        "@eslint/js": "9.27.0",
        "@nabla/vite-plugin-eslint": "^2.0.5",
        "@signal24/openapi-client-codegen": "^2.5.0",
        "@tsconfig/node22": "^22.0.1",
        "@types/jsdom": "^21.1.7",
        "@types/lodash": "^4.17.16",
        "@types/node": "^22.15.18",
        "@types/uuid": "^10.0.0",
        "@vitejs/plugin-vue": "^5.2.4",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.5.0",
        "@vue/test-utils": "^2.4.6",
        "@vue/tsconfig": "^0.7.0",
        "cypress": "^14.3.3",
        "date-fns": "^4.1.0",
        "eslint": "9.27.0",
        "eslint-plugin-cypress": "^4.3.0",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "eslint-plugin-unused-imports": "^4.1.4",
        "eslint-plugin-vue": "^10.1.0",
        "jsdom": "^26.1.0",
        "lodash": "^4.17.21",
        "prettier": "^3.5.3",
        "sass": "^1.89.0",
        "start-server-and-test": "^2.0.12",
        "type-fest": "^4.41.0",
        "typescript": "~5.8",
        "typescript-eslint": "^8.32.1",
        "vite": "^6.3.5",
        "vitest": "^3.1.3",
        "vue": "^3.5.14",
        "vue-tsc": "^2.2.10"
    },
    "packageManager": "yarn@4.6.0"
}
