{
    "name": "@zyno-io/vue-foundation",
    "version": "4.33.3",
    "description": "Common components, directives, and helpers for Vue 3 apps",
    "license": "MIT",
    "author": {
        "name": "Zyno Consulting",
        "email": "support@zyno.io",
        "url": "https://zyno.io"
    },
    "repository": {
        "url": "https://github.com/zyno-io/vue-foundation"
    },
    "type": "module",
    "module": "./dist/vue-foundation.es.js",
    "typings": "./dist/src/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/src/index.d.ts",
            "import": "./dist/vue-foundation.es.js"
        },
        "./dist/vue-foundation.css": {
            "import": "./dist/vue-foundation.css",
            "require": "./dist/vue-foundation.css"
        },
        "./vite-plugins": {
            "types": "./dist/src/vite-plugins/index.d.ts",
            "import": "./dist/src/vite-plugins/index.js"
        }
    },
    "scripts": {
        "dev": "vite",
        "build": "rm -rf dist && vite build && tsc -p tsconfig.vite-plugins.json && find dist -name '*.tsbuildinfo' -delete && vue-tsc -p tsconfig.app.json",
        "build:watch": "fswatch -o src | xargs -n1 -I{} yarn build",
        "test:types": "vue-tsc -p tsconfig.vitest.json",
        "test:unit": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:dev": "playwright test --ui",
        "test:e2e:dev:remote": "DISPLAY=:0 yarn test:e2e:dev",
        "lint": "oxlint --fix .",
        "format": "oxfmt",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs"
    },
    "dependencies": {
        "currency.js": "^2.0.4",
        "mark.js": "^8.11.1",
        "uuid": "^13.0.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.58.2",
        "@tsconfig/node22": "^22.0.5",
        "@types/jsdom": "^28.0.1",
        "@types/lodash": "^4.17.24",
        "@types/mark.js": "^8",
        "@types/node": "^25.5.0",
        "@types/uuid": "^11.0.0",
        "@vitejs/plugin-vue": "^6.0.5",
        "@vitest/coverage-v8": "^4.1.2",
        "@vue/test-utils": "^2.4.6",
        "@vue/tsconfig": "^0.9.1",
        "@zyno-io/openapi-client-codegen": "^2.8.0",
        "date-fns": "^4.1.0",
        "happy-dom": "^20.8.9",
        "jsdom": "^29.0.1",
        "lefthook": "^2.1.4",
        "lodash": "^4.17.23",
        "oxfmt": "^0.42.0",
        "oxlint": "^1.57.0",
        "sass": "^1.98.0",
        "start-server-and-test": "^3.0.0",
        "type-fest": "^5.5.0",
        "typescript": "~6.0",
        "vite": "^8.0.3",
        "vite-plugin-oxlint": "^2.0.1",
        "vite-plugin-vue-tailwind-auto-reference": "^2.0.1",
        "vitepress": "^1.6.4",
        "vitest": "^4.1.2",
        "vue": "^3.5.31",
        "vue-tsc": "^3.2.6"
    },
    "peerDependencies": {
        "@zyno-io/openapi-client-codegen": "^2.7.0",
        "date-fns": "^3.0.6",
        "lodash": "^4.17.21",
        "vue": "^3.4.0"
    },
    "packageManager": "yarn@4.13.0"
}
