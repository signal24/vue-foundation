{
    "name": "@zyno-io/vue-foundation",
    "type": "module",
    "version": "4.33.1",
    "description": "Common components, directives, and helpers for Vue 3 apps",
    "module": "./dist/vue-foundation.es.js",
    "exports": {
        ".": {
            "import": "./dist/vue-foundation.es.js",
            "types": "./dist/src/index.d.ts"
        },
        "./dist/vue-foundation.css": {
            "import": "./dist/vue-foundation.css",
            "require": "./dist/vue-foundation.css"
        },
        "./vite-plugins": {
            "import": "./dist/src/vite-plugins/index.js",
            "types": "./dist/src/vite-plugins/index.d.ts"
        }
    },
    "typings": "./dist/src/index.d.ts",
    "scripts": {
        "dev": "vite",
        "build": "rm -rf dist && vite build && tsc -p tsconfig.vite-plugins.json && find dist -name '*.tsbuildinfo' -delete && vue-tsc -p tsconfig.app.json",
        "build:watch": "fswatch -o src | xargs -n1 -I{} yarn build",
        "test:types": "vue-tsc -p tsconfig.vitest.json",
        "test:unit": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:dev": "playwright test --ui",
        "test:e2e:dev:remote": "DISPLAY=:0 yarn test:e2e:dev",
        "lint": "oxlint --fix .",
        "format": "prettier --write .",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs"
    },
    "license": "MIT",
    "author": {
        "name": "Zyno Consulting",
        "email": "support@zyno.io",
        "url": "https://zyno.io"
    },
    "repository": {
        "url": "https://github.com/zyno-io/vue-foundation"
    },
    "dependencies": {
        "currency.js": "^2.0.4",
        "mark.js": "^8.11.1",
        "uuid": "^13.0.0"
    },
    "peerDependencies": {
        "@zyno-io/openapi-client-codegen": "^2.7.0",
        "date-fns": "^3.0.6",
        "lodash": "^4.17.21",
        "vue": "^3.4.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.58.2",
        "@tsconfig/node22": "^22.0.5",
        "@types/jsdom": "^27.0.0",
        "@types/lodash": "^4.17.23",
        "@types/mark.js": "^8",
        "@types/node": "^25.2.3",
        "@types/uuid": "^11.0.0",
        "@vitejs/plugin-vue": "^6.0.4",
        "@vitest/coverage-v8": "^4.0.18",
        "@vue/test-utils": "^2.4.6",
        "@vue/tsconfig": "^0.8.1",
        "@zyno-io/openapi-client-codegen": "^2.7.0",
        "date-fns": "^4.1.0",
        "happy-dom": "^20.6.1",
        "jsdom": "^28.1.0",
        "lefthook": "^2.1.1",
        "lodash": "^4.17.23",
        "oxlint": "^1.47.0",
        "prettier": "^3.8.1",
        "sass": "^1.97.3",
        "start-server-and-test": "^2.1.3",
        "type-fest": "^5.4.4",
        "typescript": "~5.9",
        "vite": "^7.3.1",
        "vite-plugin-oxlint": "^1.6.0",
        "vite-plugin-vue-tailwind-auto-reference": "^2.0.1",
        "vitepress": "^1.6.4",
        "vitest": "^4.0.18",
        "vue": "^3.5.28",
        "vue-tsc": "^3.2.4"
    },
    "packageManager": "yarn@4.9.2"
}
